# Copy to .env and adjust for your machine.
# Port 5433 = Docker Compose Postgres (avoids conflict with local Postgres on 5432)
DATABASE_URL=postgresql://darkstore:darkstore@localhost:5433/darkstore

# Signs JWT access tokens returned by POST /api/auth/login
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Token lifetime in seconds (default: 8 hours)
JWT_EXPIRES_IN_SECONDS=28800

# API server port
PORT=3001

# Frontend origins for CORS, comma-separated (dark-store-portal, customer-app)
CORS_ORIGIN=http://localhost:8080,http://localhost:5174

# Google Identity Services (optional — enables POST /api/auth/google)
# Create an OAuth 2.0 Web client in Google Cloud Console and paste the Client ID.
# Must match VITE_GOOGLE_CLIENT_ID in the portal .env.local
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Resend (optional — enables emailing manager invite/setup links).
# Sign up free at https://resend.com (no credit card), then grab an API key
# from https://resend.com/api-keys. Without this set, invite links are
# copy-only in the UI — nothing else breaks.
# RESEND_API_KEY=re_xxx

# Must be a verified sender on your Resend account. For local dev you can
# leave this as onboarding@resend.dev (Resend's shared sandbox address,
# only deliverable to the email you signed up with) until you verify your
# own domain in the Resend dashboard.
# EMAIL_FROM=Q-Commerce <onboarding@resend.dev>

# Portal origin used to build the link inside invite emails.
# PORTAL_URL=http://localhost:8080
